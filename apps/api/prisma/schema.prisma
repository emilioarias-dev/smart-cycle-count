// Prisma schema for the API. The client is generated into src/generated/prisma
// (git-ignored); regenerate it with `npm run db:generate`.
//
// Some rules cannot be expressed here and live as CHECK constraints in the
// migrations (code format, quantity rules, movement shapes); see D-006 to D-008.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Relative imports end in .js, as compiled ESM output requires (E-005).
  importFileExtension = "js"
}

// The connection URL is configured in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

// A storage location. The code (A-01-03) is derived from aisle, rack and
// position (D-006).
model Bin {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  aisle            String
  rack             Int
  position         Int
  // Incremented once by every movement that touches the bin (D-001, D-008).
  inventoryVersion Int       @default(0) @map("inventory_version")
  // Simulated antecedent; no audit records behind it yet (D-009).
  lastAuditedAt    DateTime? @map("last_audited_at") @db.Timestamptz(3)

  pallets       Pallet[]
  movementsFrom Movement[]  @relation("MovementFromBin")
  movementsTo   Movement[]  @relation("MovementToBin")
  score         BinScore?
  auditTasks    AuditTask[]
  counts        Count[]

  @@unique([aisle, rack, position])
  @@map("bins")
}

// Quantities of a product are always expressed in its unit (D-007).
model Product {
  id   Int    @id @default(autoincrement())
  sku  String @unique
  name String
  unit String

  pallets         Pallet[]
  unexpectedFinds UnexpectedPallet[]

  @@map("products")
}

// One product per pallet (D-003). A pallet with a positive quantity is in a
// bin; a depleted pallet (quantity 0) has no bin and is kept for history.
model Pallet {
  id        Int    @id @default(autoincrement())
  code      String @unique
  productId Int    @map("product_id")
  binId     Int?   @map("bin_id")
  quantity  Int

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  bin        Bin?        @relation(fields: [binId], references: [id], onDelete: Restrict)
  movements  Movement[]
  countLines CountLine[]

  @@index([binId])
  @@map("pallets")
}

enum MovementType {
  PUTAWAY
  PICK
  MOVE
  ADJUSTMENT
}

// The movement log. Its id is the application order (D-008).
model Movement {
  id             Int          @id @default(autoincrement())
  type           MovementType
  palletId       Int          @map("pallet_id")
  fromBinId      Int?         @map("from_bin_id")
  toBinId        Int?         @map("to_bin_id")
  quantityChange Int          @map("quantity_change")
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)

  pallet  Pallet @relation(fields: [palletId], references: [id], onDelete: Restrict)
  fromBin Bin?   @relation("MovementFromBin", fields: [fromBinId], references: [id], onDelete: Restrict)
  toBin   Bin?   @relation("MovementToBin", fields: [toBinId], references: [id], onDelete: Restrict)

  @@index([palletId])
  @@index([fromBinId])
  @@index([toBinId])
  @@index([occurredAt])
  @@map("movements")
}

// The latest risk score of a bin (D-005, D-010), replaced on every
// recompute. The breakdown holds everything needed to reproduce it.
model BinScore {
  binId          Int      @id @map("bin_id")
  score          Int
  formulaVersion Int      @map("formula_version")
  // The "now" the score was computed for (the window ends here).
  referenceAt    DateTime @map("reference_at") @db.Timestamptz(3)
  // When the computation actually ran.
  computedAt     DateTime @map("computed_at") @db.Timestamptz(3)
  breakdown      Json

  bin Bin @relation(fields: [binId], references: [id], onDelete: Restrict)

  @@map("bin_scores")
}

enum AuditTaskStatus {
  PENDING
  DONE
}

// A Top N audit plan (D-011). Keeps what was requested and why bins were
// left out, next to the tasks it created.
model AuditPlan {
  id               Int      @id @default(autoincrement())
  requestedCount   Int      @map("requested_count")
  excludedPending  Int      @map("excluded_pending")
  excludedUnscored Int      @map("excluded_unscored")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tasks AuditTask[]

  @@map("audit_plans")
}

// One bin to audit. It keeps a full copy of the score that selected it
// (D-002), so a later recompute does not change why it is in the plan.
// PostgreSQL allows at most one PENDING task per bin (partial unique index in
// the migration).
model AuditTask {
  id               Int             @id @default(autoincrement())
  planId           Int             @map("plan_id")
  binId            Int             @map("bin_id")
  // Position in the plan, from 1.
  rank             Int
  status           AuditTaskStatus @default(PENDING)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  // Set when a count closes the task (milestone 5).
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(3)
  score            Int
  priority         String
  formulaVersion   Int             @map("formula_version")
  scoreReferenceAt DateTime        @map("score_reference_at") @db.Timestamptz(3)
  scoreComputedAt  DateTime        @map("score_computed_at") @db.Timestamptz(3)
  breakdown        Json

  plan  AuditPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  bin   Bin       @relation(fields: [binId], references: [id], onDelete: Restrict)
  count Count?

  @@unique([planId, rank])
  @@unique([planId, binId])
  // Lets a count reference its task and bin together (D-012).
  @@unique([id, binId])
  @@index([binId])
  @@map("audit_tasks")
}

enum CountResult {
  PASS
  FAIL
}

// The count of one task (D-001, D-003, D-012): at most one per task. It
// keeps the expected values next to the counted ones and never changes
// inventory (D-004). PASS/FAIL is derived from the lines and the unexpected
// pallets and checked in the same transaction.
model Count {
  id               Int         @id @default(autoincrement())
  taskId           Int         @unique @map("task_id")
  // Always the task's bin: the foreign key covers both columns.
  binId            Int         @map("bin_id")
  result           CountResult
  // The version shown when the count was opened, equal to the bin's
  // version when it was saved (D-001).
  inventoryVersion Int         @map("inventory_version")
  // Server time of the count; also the bin's new audit date and the
  // reference of the recompute that followed (D-012).
  countedAt        DateTime    @map("counted_at") @db.Timestamptz(3)

  task       AuditTask          @relation(fields: [taskId, binId], references: [id, binId], onDelete: Restrict)
  bin        Bin                @relation(fields: [binId], references: [id], onDelete: Restrict)
  lines      CountLine[]
  unexpected UnexpectedPallet[]

  @@unique([taskId, binId])
  @@index([binId, countedAt])
  @@map("counts")
}

// One expected pallet: the expected quantity copied from inventory at the
// count, the counted quantity and the variance (counted − expected).
model CountLine {
  id               Int @id @default(autoincrement())
  countId          Int @map("count_id")
  palletId         Int @map("pallet_id")
  expectedQuantity Int @map("expected_quantity")
  countedQuantity  Int @map("counted_quantity")
  variance         Int

  count  Count  @relation(fields: [countId], references: [id], onDelete: Restrict)
  pallet Pallet @relation(fields: [palletId], references: [id], onDelete: Restrict)

  @@unique([countId, palletId])
  @@index([palletId])
  @@map("count_lines")
}

// A pallet found in the bin that the system did not expect (D-012). The code
// is stored as typed (normalised); the product is optional: without it the
// quantity is in units declared by the operator, with no catalog unit.
model UnexpectedPallet {
  id        Int    @id @default(autoincrement())
  countId   Int    @map("count_id")
  code      String
  quantity  Int
  productId Int?   @map("product_id")

  count   Count    @relation(fields: [countId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([countId, code])
  @@index([productId])
  @@map("count_unexpected_pallets")
}
