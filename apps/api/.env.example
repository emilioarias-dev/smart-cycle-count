# Copy to .env (git-ignored). Local development values only, no secrets.

# Development database: the Compose container, published on host port 5433
# (see docker-compose.yml).
DATABASE_URL="postgresql://scc:scc_local_dev@localhost:5433/smart_cycle_count"

# Separate database used by the API tests. The tests apply migrations to it
# and delete its rows, so it must never point to the development database.
TEST_DATABASE_URL="postgresql://scc:scc_local_dev@localhost:5433/smart_cycle_count_test"

# HTTP port of the API.
PORT=3001

# Optional: reference time for `npm run db:reset-demo`, with an explicit zone.
# Same value ⇒ same demo data. Without it, the current time is used.
# SEED_NOW="2026-10-18T12:00:00Z"
