# Copy to .env (git-ignored). Local development values only, no secrets.

# Development database: the Compose container, published on host port 5433
# (see docker-compose.yml).
DATABASE_URL="postgresql://scc:scc_local_dev@localhost:5433/smart_cycle_count"

# Separate database used by the API tests. The tests apply migrations to it
# and delete its rows, so it must never point to the development database.
TEST_DATABASE_URL="postgresql://scc:scc_local_dev@localhost:5433/smart_cycle_count_test"

# HTTP port of the API.
PORT=3001

# Optional: reference time for `npm run db:reset-demo`, with an explicit zone.
# Same value ⇒ same demo data. Without it, the current time is used.
# SEED_NOW="2026-10-18T12:00:00Z"

# Rivy (decision D-016), the read-only assistant on Google Gemini. Without a
# key, /rivy shows "Rivy is not configured" and the rest of the app works.
# Paste the key only into apps/api/.env (git-ignored), never into this file,
# a chat or a command line. The free tier sends questions and answers to
# Google, which may use them to improve its products: synthetic data only.
GEMINI_API_KEY=
# Model, without any automatic switch to another one.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: local guard of Gemini requests per minute (one question uses 2).
# GEMINI_RPM=15
# Optional: time limits in milliseconds, per Gemini call and per question.
# RIVY_CALL_TIMEOUT_MS=30000
# RIVY_TOTAL_TIMEOUT_MS=60000
# Only for an environment whose outbound proxy adds the key header itself
# (the Claude Code cloud container). Leave it unset on a PC.
# GEMINI_KEY_VIA_PROXY=true
