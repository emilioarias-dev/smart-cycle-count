{
  "name": "smart-cycle-count",
  "version": "0.1.0",
  "private": true,
  "description": "Risk-based cycle count planning for warehouse bins",
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11.19.1 <12"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:reset-demo": "npm run db:reset-demo -w apps/api",
    "db:reset-demo-high-risk": "npm run db:reset-demo-high-risk -w apps/api",
    "dev": "concurrently --names api,web --prefix-colors blue,green --kill-others \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm run test -w apps/api && npm run test -w apps/web"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
